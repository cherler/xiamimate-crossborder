{
  "manifest_version": 3,
  "name": "虾米跨境采集助手",
  "version": "0.1.0",
  "description": "采集当前页的商品信息与评论样本，导出到虾米跨境本地档案。",
  "default_locale": "zh_CN",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "虾米跨境采集助手",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
