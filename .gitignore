# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# TypeScript incremental build info
*.tsbuildinfo

# Claude Code local overrides (permissions, autoloop hooks)
.claude/settings.local.json

# Codex 工具本地产物(与产品代码无关)
.codex/
AGENTS.md

# chrome 制品的 dev 副本 —— 生成物，真源是 scripts/build-chrome-artifacts.mjs
public/chrome/

# 精灵表预览图 —— scripts/pet-sheet.mjs 的产物,看完就丢
assets-tmp/

# Built collector bundles, regenerated for every Pages build
/extension/dist/
/public/downloads/
